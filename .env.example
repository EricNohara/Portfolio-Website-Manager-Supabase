# Server-only AWS identity used to invoke the AI-agent Lambda Function URLs.
# Never use NEXT_PUBLIC_ names for these values.
AI_AGENT_AWS_ACCESS_KEY_ID=
AI_AGENT_AWS_SECRET_ACCESS_KEY=
# Set only when using temporary AWS credentials.
AI_AGENT_AWS_SESSION_TOKEN=
AI_AGENT_AWS_REGION=us-east-2

# Shared DynamoDB table; use a distinct namespace per deployment environment.
AI_AGENT_RATE_LIMIT_TABLE_NAME=Nukleio-Ai-Rate-Limits
AI_AGENT_RATE_LIMIT_NAMESPACE=development

# Existing Lambda Function URL settings.
RESUME_AGENT_BASE_URL=
COVER_LETTER_AGENT_BASE_URL=
PROFESSIONAL_HEADSHOT_AGENT_BASE_URL=
